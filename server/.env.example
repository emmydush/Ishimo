# ─── Server ───────────────────────────────────────────────────────────────────
# Port the API listens on (docker-compose pins this to 3000)
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. REQUIRED — the server refuses to boot without it.
#   Local:      postgres://postgres:postgres@localhost:5432/ishimo
#   Docker:     docker-compose.yml sets it automatically (postgres service)
#   Render:     injected from the managed PostgreSQL database (render.yaml)
# Every deploy dumps the database into <BACKUP_DIR>/backups (last 5 kept).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ishimo

# ─── Media URLs ───────────────────────────────────────────────────────────────
# Leave empty to return same-origin links (/uploads/photo.jpg), which work
# behind the nginx reverse proxy. Set an absolute origin only if the API is
# served from a different domain, e.g. https://api.example.com
# PUBLIC_BASE_URL=

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# Throttling is enabled by default, per client IP:
#   writes 30/10min, public reads 120/min, admin 60/5min.
# Auth endpoints (login, register, password reset) are never throttled.
# Set to false to disable request throttling entirely.
# RATE_LIMITING_ENABLED=true

# ─── Admin ────────────────────────────────────────────────────────────────────
# The password is stored as a bcrypt hash in the database; these are only used
# to bootstrap the admin login when no hash exists yet.
# Create or reset it with: npm run admin:create -- --force
# Use --generate to create a strong random password (printed once).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Token required by the /api/admin/* endpoints (sent as the x-admin-token header)
ADMIN_TOKEN=admin-secret-token-ishimo
